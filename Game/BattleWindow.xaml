<Window x:Class="Game.BattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game"
        mc:Ignorable="d"
        Title="Кликер" Height="400" Width="900" ResizeMode="NoResize">
    <!-- Увеличим ширину -->

    <Grid Margin="15,15,15,15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <!-- Инфа о враге -->
            <ColumnDefinition Width="2*" />
            <!-- Иконка врага и игрок -->
            <ColumnDefinition Width="1*" />
            <!-- Лог действий -->
        </Grid.ColumnDefinitions>

        <!-- Левая часть: информация о враге -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="10,0,10,0">
            <TextBlock Text="Enemy name" FontSize="22" FontWeight="Bold" FontStyle="Italic" Margin="0,0,0,4" HorizontalAlignment="Center"/>
            <TextBox x:Name="EnemyNameText" FontSize="18" IsReadOnly="True" Margin="0,0,0,12"/>

            <Separator Margin="0,0,0,12"/>

            <TextBlock Text="Enemy hitpoints" FontSize="20" Margin="0,0,0,4"/>
            <TextBox x:Name="EnemyHPText" FontSize="18" IsReadOnly="True" Margin="0,0,0,8"/>

            <TextBlock Text="Gold from enemy:" FontSize="20" Margin="0,10,0,4"/>
            <TextBox x:Name="EnemyGoldText" FontSize="18" IsReadOnly="True" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Центральная часть: иконка врага и инфа об игроке -->
        <Grid Grid.Column="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="210"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: иконка и кнопки -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Height="231" Margin="1,0,1,0">
                <!-- Иконка врага с Canvas для бонусов ПОВЕРХ -->
                <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Center" Padding="5" Margin="0,10,0,10">
                    <Grid>
                        <!-- Картинка врага -->
                        <Image x:Name="EnemyIcon"
                               Width="150"
                               Height="150"
                               Stretch="Uniform"
                               Cursor="Hand"
                               MouseDown="EnemyIcon_MouseDown"/>

                        <!-- Canvas для бонусов ПОВЕРХ картинки -->
                        <Canvas x:Name="BonusCanvas" Background="Transparent" 
                                MouseDown="BonusCanvas_MouseDown" IsHitTestVisible="True"
                                Width="150" Height="150"/>
                    </Grid>
                </Border>

                <!-- Кнопки Repeat и Next -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <Button x:Name="RepeatButton" Content="Repeat" Width="100" Height="35" Click="RepeatButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Content="Next" Width="100" Height="35" Click="NextButton_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Правая часть: инфа об игроке -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" Height="342">
                <TextBlock Text="Level:" FontSize="20" Margin="0,0,0,4"/>
                <TextBox x:Name="PlayerLevelText" FontSize="18" IsReadOnly="True"/>
                <TextBlock Text="Player gold:" FontSize="20"/>
                <TextBox x:Name="PlayerGoldText" FontSize="18" IsReadOnly="True" Margin="0,0,0,8"/>
                <TextBlock Text="Player damage:" FontSize="20"/>
                <TextBox x:Name="PlayerDamageText" FontSize="18" IsReadOnly="True" Margin="0,0,0,8"/>
                <TextBlock Text="Перезарядка:" FontSize="20"/>
                <TextBox x:Name="CooldownText" FontSize="18" IsReadOnly="True" Margin="0,0,0,8"/>

                <Button x:Name="UpgradeButton" Content="Upgrade" Width="120" Height="35" Click="UpgradeButton_Click" Margin="0,0,0,5"/>
                <Button x:Name="UpgradeCooldownButton" Content="Upgrade attack speed" Width="120" Height="35" Click="UpgradeCooldownButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Правая часть: Лог действий -->
        <StackPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="Logs" FontSize="22" FontWeight="Bold" FontStyle="Italic" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <Border BorderBrush="Gray" BorderThickness="1" Background="White" Height="315">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="289" VerticalAlignment="Top">
                    <TextBlock x:Name="ActionLogText" FontSize="14" Margin="10" TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Window>