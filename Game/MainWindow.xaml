<Window x:Class="Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор врагов" Height="620" Width="1100" MouseDown="Window_MouseDown" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левый блок: Список врагов -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel>
                <TextBlock Text="Список врагов:" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <ListBox x:Name="EnemiesListBox" Height="380"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Сохранить" FontSize="16" Width="100" Margin="0,0,8,0" Height="32" Click="SaveEnemies_Click"/>
                    <Button Content="Загрузить" FontSize="16" Width="100" Height="32" Click="LoadEnemies_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Центральный блок: Редактирование врага -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12" Margin="10,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя часть: Иконка и название -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка врага -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Иконка врага:" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
                        <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="120" Background="White" CornerRadius="2">
                            <Image x:Name="SelectedEnemyIcon" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>

                    <!-- Название врага -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="Название врага:" FontSize="16" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnemyNameBox" Width="260" Height="24" FontSize="14"/>
                        <TextBlock Text="Имя иконки:" FontSize="16" Margin="0,12,0,4"/>
                        <TextBox x:Name="IconNameBox" Width="260" Height="24" FontSize="14" IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- Средняя часть: Основные параметры -->
                <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,15,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка параметров -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
                            <TextBlock Text="Здоровье:" FontSize="16" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <TextBox x:Name="BaseLifeBox" Width="140" Height="24" FontSize="14" HorizontalAlignment="Center"/>

                            <TextBlock Text="Модификатор здоровья:" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBox x:Name="LifeModifierBox" Width="140" Height="24" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Правая колонка параметров -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
                            <TextBlock Text="Золото:" FontSize="16" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <TextBox x:Name="BaseGoldBox" Width="140" Height="24" FontSize="14" HorizontalAlignment="Center"/>

                            <TextBlock Text="Модификатор золота:" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                            <TextBox x:Name="GoldModifierBox" Width="140" Height="24" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Нижняя часть: Тип врага и шанс -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Выбор типа врага -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Width="140" Margin="0,0,20,0">
                        <TextBlock Text="Тип врага:" FontSize="16" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EnemyTypeComboBox" Width="140" Height="26" FontSize="14" SelectedIndex="0">
                            <ComboBoxItem Content="Обычный" Tag="Normal"/>
                            <ComboBoxItem Content="Бронированный" Tag="Armored"/>
                            <ComboBoxItem Content="Уменьшающийся" Tag="Shrinking"/>
                            <ComboBoxItem Content="Исцеляющийся" Tag="Healing"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Специальный параметр типа -->
                    <StackPanel x:Name="TypeSpecificPanel" Grid.Column="1" Orientation="Vertical" Width="180" Margin="0,0,20,0" Visibility="Collapsed">
                        <TextBlock x:Name="TypeParamLabel" Text="Параметр:" FontSize="16" Margin="0,0,0,4"/>
                        <TextBox x:Name="TypeParamBox" Width="180" Height="24" FontSize="14"/>
                    </StackPanel>

                    <!-- Шанс появления -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" Width="140">
                        <TextBlock Text="Шанс появления:" FontSize="16" Margin="0,0,0,4"/>
                        <TextBox x:Name="SpawnChanceBox" Width="140" Height="24" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопки управления -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Добавить" FontSize="16" Width="110" Margin="0,0,15,0" Height="34" Click="AddEnemy_Click"/>
                    <Button Content="Удалить" FontSize="16" Width="110" Height="34" Click="RemoveEnemy_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правый блок: Библиотека иконок -->
        <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel>
                <TextBlock Text="Библиотека иконок:" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2" Height="420">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="IconsPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="90" Height="90" Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2"
                                            Background="White" Cursor="Hand">
                                        <Button Click="IconButton_Click" Background="Transparent" BorderThickness="0" Padding="0">
                                            <Image Source="{Binding ImagePath}" Stretch="Uniform" Width="80" Height="80"/>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- Кнопка запуска боя -->
        <Button Content="НАЧАТЬ БОЙ" Grid.Row="1" Grid.Column="1" FontSize="18" FontWeight="Bold" 
                Width="200" Height="44" HorizontalAlignment="Right" Margin="0,15,210,0" Click="StartBattleButton_Click">
        </Button>
    </Grid>
</Window>